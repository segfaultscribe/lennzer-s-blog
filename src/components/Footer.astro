---
const currentYear = new Date().getFullYear();
const social = {
  github: "segfaultscribe",
  twitter: "adithyalennzer",
  email: "segfaultscribe@gmail.com"
};
import '../styles/footer.css'
---

<footer>
  <div class="footer-content">
    <div class="footer-links">
      <a href={`https://github.com/${social.github}`} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span class="separator">·</span>
      <a href={`https://twitter.com/${social.twitter}`} target="_blank" rel="noopener noreferrer">Twitter</a>
      <span class="separator">·</span>
      <a href={`mailto:${social.email}`}>Contact</a>
    </div>
    <p class="footer-text">© {currentYear} Lennzer. All rights reserved.</p>
  </div>
</footer>